# Supabase – hämta värden från: https://supabase.com/dashboard → ditt projekt → Settings → API
# Dessa VITE_ variabler måste vara tillgängliga vid buildtid i Vercel.
# I Vercel används build.env för att injicera dem under bundling.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API-Football – hämta nyckeln från: https://dashboard.api-football.com/
# VITE_API_FOOTBALL_KEY används i frontend-bundlen och är alltså en publik klientnyckel.
VITE_API_FOOTBALL_KEY=your_api_football_key_here

# API_FOOTBALL_KEY används endast av server-side sync-skriptet.
# Det ska inte exponeras i frontend-koden.
API_FOOTBALL_KEY=your_api_football_key_here

# Supabase service role key används av server-side syncskript och ska inte distribueras i frontend.
# Spara den endast som server-side secret, t.ex. i Vercel Project Settings eller CI.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
